<mj-column width="100%">
  <mj-text font-size="15px" color="#374151">
    {{ greeting }}
  </mj-text>

  <mj-text font-size="15px" color="#374151" padding-top="16px">
    {{ intro }}
  </mj-text>

  <mj-button
    href="{{conversationUrl}}"
    align="center"
    padding-top="20px"
    padding-bottom="24px"
  >
    {{ cta }}
  </mj-button>

  <mj-text padding="0">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 12px;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        overflow: hidden;
      "
    >
      <tr>
        <td
          style="
            padding: 12px 22px;
            background-color: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            font-family:
              &quot;Inter&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial,
              sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: #0d9488;
            text-transform: uppercase;
            line-height: 1.5;
          "
        >
          {{ planHeader }}
        </td>
      </tr>
      <tr>
        <td
          style="
            padding: 18px 22px;
            background-color: #ffffff;
            font-family:
              &quot;Inter&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial,
              sans-serif;
            font-size: 14px;
            color: #374151;
            line-height: 1.55;
          "
        >
          <ol style="margin: 0; padding-left: 20px">
            {{#each operations}}
            <li style="margin-bottom: 6px; color: #111827">{{ title }}</li>
            {{/each}}
          </ol>
        </td>
      </tr>
    </table>
  </mj-text>
</mj-column>
