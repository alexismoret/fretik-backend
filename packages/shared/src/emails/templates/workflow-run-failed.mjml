<mj-column width="100%">
  <mj-text font-size="15px" color="#374151">
    {{ greeting }}
  </mj-text>

  <mj-text font-size="15px" color="#374151" padding-top="16px">
    {{ intro }}
  </mj-text>

  <mj-button
    href="{{runUrl}}"
    align="center"
    padding-top="20px"
    padding-bottom="24px"
  >
    {{ cta }}
  </mj-button>

  <mj-text padding="0">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 12px;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        overflow: hidden;
      "
    >
      <tr>
        <td
          style="
            padding: 12px 22px;
            background-color: #fef2f2;
            border-bottom: 1px solid #e5e7eb;
            font-family:
              &quot;Inter&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial,
              sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: #dc2626;
            text-transform: uppercase;
            line-height: 1.5;
          "
        >
          {{ errorHeader }}
        </td>
      </tr>
      <tr>
        <td
          style="
            padding: 18px 22px;
            background-color: #ffffff;
            font-family:
              &quot;Inter&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial,
              sans-serif;
            font-size: 14px;
            color: #374151;
            line-height: 1.55;
          "
        >
          {{#if errorCode}}
          <div
            style="
              font-family:
                ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
              font-size: 12px;
              color: #dc2626;
              margin-bottom: 8px;
            "
          >
            {{ errorCode }}
          </div>
          {{/if}}
          <div style="color: #111827">{{ errorMessage }}</div>
        </td>
      </tr>
    </table>
  </mj-text>

  {{#if summaryHtml}}
  <mj-text padding="16px 0 0 0">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border-radius: 12px;
        background-color: #ffffff;
        border: 1px solid #e5e7eb;
        overflow: hidden;
      "
    >
      <tr>
        <td
          style="
            padding: 12px 22px;
            background-color: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
            font-family:
              &quot;Inter&quot;, &quot;Helvetica Neue&quot;, Helvetica, Arial,
              sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: #0d9488;
            text-transform: uppercase;
            line-height: 1.5;
          "
        >
          {{ resultHeader }}
        </td>
      </tr>
      <tr>
        <td style="padding: 18px 22px 6px 22px; background-color: #ffffff">
          {{{ summaryHtml }}}
        </td>
      </tr>
    </table>
  </mj-text>
  {{/if}}
</mj-column>
