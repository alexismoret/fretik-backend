{
  "name": "@fretik/render",
  "version": "0.6.2",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun scripts/sync-contract.ts --check",
    "sync-contract": "bun scripts/sync-contract.ts"
  },
  "exports": {
    "./core/*": "./src/core/*.ts",
    "./catalogs/*": "./src/catalogs/*.ts",
    "./runtime/*": "./src/runtime/*.ts"
  },
  "dependencies": {
    "@json-render/core": "0.19.0",
    "jsonata": "^2.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
