{
  "name": "@fretik/shared",
  "version": "0.5.15",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests/unit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "e2b:build": "bun run src/services/e2b/template/build.ts",
    "grant:super-admin": "bun --env-file=.env run src/scripts/grant-super-admin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./services/*": "./src/services/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./emails/*": "./src/emails/*.ts",
    "./templates/*": "./src/templates/*.ts",
    "./templates/document-fields": "./src/templates/document-fields/index.ts",
    "./external-apps/*": "./src/external-apps/*.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.10",
    "@aws-sdk/client-s3": "^3.1072.0",
    "@aws-sdk/s3-request-presigner": "^3.1072.0",
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@better-auth/electron": "^1.6.23",
    "@better-auth/redis-storage": "^1.6.23",
    "@e2b/code-interpreter": "^2.6.1",
    "@hono/zod-openapi": "^1.4.0",
    "@mistralai/mistralai": "^2.2.6",
    "@nangohq/node": "^0.70.7",
    "@trigger.dev/sdk": "4.5.0",
    "ai": "^7.0.19",
    "better-auth": "^1.6.23",
    "bullmq": "^5.79.0",
    "chromiumly": "^5.2.1",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "e2b": "^2.30.2",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.1",
    "handlebars": "^4.7.9",
    "hono": "^4.12.26",
    "hono-rate-limiter": "^0.5.3",
    "i18next": "^26.3.1",
    "ioredis": "5.10.1",
    "jose": "^6.2.3",
    "marked": "^18.0.5",
    "mjml": "^5.3.0",
    "node-poppler": "^9.1.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mjml": "^5.0.0",
    "@types/pg": "^8.20.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^1.0.0-rc.4-5d5b77c",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
