<mj-column width="100%">
  <mj-text>{{ greeting }}</mj-text>

  <mj-text padding-top="12px">{{ message }}</mj-text>

  <mj-text padding-top="20px">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e4e4e7;
        border-radius: 2px;
      "
    >
      <tr>
        <td
          style="
            padding: 12px 16px;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 14px;
            line-height: 22px;
            color: #3f3f46;
          "
        >
          <div>
            <span
              style="
                display: inline-block;
                width: 7px;
                height: 7px;
                margin-right: 8px;
                background-color: #14b8a6;
                vertical-align: 1px;
              "
            ></span
            >{{ organizationLabel }}
          </div>
          {{#if teamLabel}}
          <div style="padding-left: 15px">{{ teamLabel }}</div>
          {{/if}}
          {{#if roleLabel}}
          <div style="padding-left: 15px">{{ roleLabel }}</div>
          {{/if}}
        </td>
      </tr>
    </table>
  </mj-text>

  {{#if accountNote}}
  <mj-text padding-top="16px">{{ accountNote }}</mj-text>
  {{/if}}

  <mj-button href="{{acceptUrl}}" padding-top="28px" padding-bottom="28px">
    {{ cta }}
  </mj-button>

  <mj-text font-size="13px" line-height="20px" color="#71717a">
    {{ expiration }}
  </mj-text>

  <mj-text
    padding-top="4px"
    font-size="13px"
    line-height="20px"
    color="#a1a1aa"
  >
    {{ ignore }}
  </mj-text>
</mj-column>
