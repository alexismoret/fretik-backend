<mj-column width="100%">
  <mj-text>{{ greeting }}</mj-text>

  <mj-text padding-top="12px">{{ intro }}</mj-text>

  <mj-button href="{{runUrl}}" padding-top="24px" padding-bottom="28px">
    {{ cta }}
  </mj-button>

  <mj-text padding="0">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #fecaca;
        border-radius: 2px;
      "
    >
      <tr>
        <td
          style="
            padding: 10px 16px;
            background-color: #fef2f2;
            border-bottom: 1px solid #fecaca;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 12px;
            font-weight: 600;
            line-height: 16px;
            color: #b91c1c;
          "
        >
          <span
            style="
              display: inline-block;
              width: 7px;
              height: 7px;
              margin-right: 8px;
              background-color: #dc2626;
              vertical-align: 1px;
            "
          ></span
          >{{ errorHeader }}
        </td>
      </tr>
      <tr>
        <td
          style="
            padding: 16px 20px;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 14px;
            line-height: 22px;
            color: #3f3f46;
          "
        >
          {{#if errorCode}}
          <div
            style="
              font-family:
                &quot;SF Mono&quot;, Menlo, Consolas,
                &quot;Liberation Mono&quot;, monospace;
              font-size: 12px;
              line-height: 18px;
              color: #b91c1c;
              margin-bottom: 6px;
            "
          >
            {{ errorCode }}
          </div>
          {{/if}}
          <div style="color: #18181b">{{ errorMessage }}</div>
        </td>
      </tr>
    </table>
  </mj-text>

  {{#if summaryHtml}}
  <mj-text padding="16px 0 0 0">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e4e4e7;
        border-radius: 2px;
      "
    >
      <tr>
        <td
          style="
            padding: 10px 16px;
            background-color: #fafafa;
            border-bottom: 1px solid #e4e4e7;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 12px;
            font-weight: 600;
            line-height: 16px;
            color: #52525b;
          "
        >
          <span
            style="
              display: inline-block;
              width: 7px;
              height: 7px;
              margin-right: 8px;
              background-color: #14b8a6;
              vertical-align: 1px;
            "
          ></span
          >{{ resultHeader }}
        </td>
      </tr>
      <tr>
        <td style="padding: 16px 20px 4px 20px">{{{ summaryHtml }}}</td>
      </tr>
    </table>
  </mj-text>
  {{/if}}
</mj-column>
