# =================================================================== #
# @fretik/api — environment variables                                  #
# =================================================================== #
# Two categories:
#   EAGER vars: read at module load. Service refuses to boot if unset.
#   LAZY  vars: read on first feature use. Service boots without them;
#               the feature itself crashes when invoked.
# Each section is annotated.

# ==================== #
# HTTP server                                                          (EAGER)
# Port the Hono server binds to. Process exits if unset.
# ==================== #
PORT=8080

# ==================== #
# Database                                                             (EAGER)
# DATABASE_URL is read by drizzle on import — every handler depends on
# `@fretik/shared/db`, so a missing URL crashes the service at boot.
# ==================== #
DATABASE_URL=

# ==================== #
# Redis                                                                (EAGER)
# Used by Better-Auth secondary storage + rate-limit middleware. Read
# at module load via `@fretik/shared/lib/redis`.
# ==================== #
REDIS_URL=

# ==================== #
# Better-Auth                                                          (EAGER)
# BETTER_AUTH_SECRET signs the session cookie. BETTER_AUTH_URL is the
# base URL where /auth/* is served. APP_URL is the frontend origin —
# read by both `lib/auth.ts` (trustedOrigins) and `emails/generators.ts`
# (invitation links). All three are read at boot.
# ==================== #
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=

# ==================== #
# Email — Scaleway TEM                                                 (EAGER)
# `@fretik/shared/lib/email` instantiates the SES client at module load.
# All five vars are required at boot. EMAIL_FROM_ADDRESS must be a
# verified sender in Scaleway TEM.
# ==================== #
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_EMAIL_REGION=fr-par
EMAIL_FROM_NAME=Fretik
EMAIL_FROM_ADDRESS=no-reply@fretik.com

# ==================== #
# S3 — Scaleway Object Storage                                         (EAGER)
# `@fretik/shared/lib/s3` builds the S3 client at module load. Document
# uploads, chat-file uploads, vector refresh all hit this.
# ==================== #
S3_BUCKET=
S3_URL=
S3_REGION=
SCW_ACCESS_KEY=

# ==================== #
# Mistral — OCR pre-extraction                                         (EAGER)
# `@fretik/shared/lib/mistral` reads this at module load. Document
# upload triggers pre-extract which calls Mistral OCR.
# ==================== #
MISTRAL_API_KEY=

# ==================== #
# @fretik/ai service — internal HTTP                                   (LAZY)
# AI_SERVICE_URL = base URL of @fretik/ai (the AI service).
# INTERNAL_KEY   = shared secret. Sent as X-Internal-Key on every
#                  internal call from api to ai; ai's
#                  `middlewares/internal.ts` verifies it.
# Both are read on the first `callAiService()` call (lazy since the
# May 2026 cleanup) — but a document upload exercises this within
# seconds, so treat them as effectively required in prod.
# ==================== #
AI_SERVICE_URL=
INTERNAL_KEY=

# ==================== #
# Gotenberg — non-PDF → PDF conversion                                 (LAZY)
# Used during document upload for Word / Excel / PowerPoint. Read only
# when `convertDocumentToPdf` is first called. If you don't ingest
# non-PDF docs, can stay empty. ENDPOINT throws if missing on first
# call; basic-auth fields are optional.
# ==================== #
GOTENBERG_ENDPOINT=
GOTENBERG_API_BASIC_AUTH_USERNAME=
GOTENBERG_API_BASIC_AUTH_PASSWORD=

# ==================== #
# External-apps — Nango (self-hosted)                                  (LAZY)
# NANGO_HOST       = base URL of the Nango instance, no trailing slash
#                    (e.g. `https://nango.fretik.com`). The `@nangohq/node`
#                    client posts to `${NANGO_HOST}/...`.
# NANGO_SECRET_KEY = environment-scoped backend key from the Nango
#                    admin dashboard → Environment Settings → Secret Key.
#                    Required scopes: `environment:proxy` +
#                    `environment:connect_sessions:write`.
# Read on first OAuth handshake / proxy call. If you don't enable any
# external app, can stay empty.
# ==================== #
NANGO_HOST=
NANGO_SECRET_KEY=

# ==================== #
# Sandbox JWT                                                          (LAZY)
# HS256 secret used by @fretik/api to verify the bearer token on
# `POST /sandbox/exec`. Must MATCH the same env var in @fretik/ai
# (which signs the JWT). Rotate together. Generate with:
#   openssl rand -hex 32
# ==================== #
SANDBOX_JWT_SECRET=
