{
  "name": "fretik-monorepo",
  "version": "0.6.6",
  "private": true,
  "workspaces": [
    "packages/render",
    "packages/shared",
    "packages/providers",
    "packages/jobs",
    "packages/workflows",
    "packages/api",
    "packages/ai"
  ],
  "scripts": {
    "prepare": "husky",
    "postinstall": "node .husky/verify.mjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --type-aware --fix",
      "prettier --write"
    ],
    "*.{json,css,md,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "patchedDependencies": {
    "ews-javascript-api@0.15.3": "patches/ews-javascript-api@0.15.3.patch"
  }
}
