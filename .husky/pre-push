# The FIRST job in every CI workflow is `bun install --frozen-lockfile`, so a
# lockfile that disagrees with the package.json files fails the run before a
# single test executes — and it fails on a diff nobody wrote, which is the worst
# kind of red build to read.
#
# It is not hypothetical. On 2026-09-07 a commit carried a bun.lock that was 615
# lines OLDER than the one it replaced: `@fretik/ai` back to 0.0.1 from 0.7.13,
# oxlint back to ^1.70.0 from ^1.80.0, the root `typescript` devDependency gone.
# Nothing in the working tree looked wrong, `git status` was clean after the
# commit, and the first sign of trouble was CI, on a push to production.
#
# This is the same command CI runs, so it cannot disagree with CI, and it takes
# about 400 ms because everything is already resolved. A bare version bump does
# NOT trip it (verified on bun 1.4.0) — only a genuine mismatch does, which is
# why `version-bump.yml` may keep bumping package.json without touching the lock.
if ! bun install --frozen-lockfile --dry-run >/dev/null 2>&1; then
  echo ""
  echo "❌ bun.lock disagrees with the package.json files — CI installs with"
  echo "   --frozen-lockfile and will fail on this before running anything."
  echo ""
  echo "   Look at the diff before you regenerate: if the lock is going"
  echo "   BACKWARDS (older versions than HEAD), you are about to commit a"
  echo "   stale copy over a good one, and the fix is to restore it:"
  echo "       git checkout HEAD -- bun.lock"
  echo ""
  echo "   If a dependency genuinely changed, regenerate and commit it:"
  echo "       bun install && git add bun.lock"
  echo ""
  exit 1
fi

bun run --filter '*' check

# The unit suites are hermetic (`--isolate`, a dead-port env wall, no service
# of any kind), so they cost seconds and can gate a push the way `check` does.
# Integration tests are NOT here: they need a disposable Postgres, and CI runs
# them.
bun run --filter '*' test

# `generated/file-types/` in the frontend repo is a copy of
# `packages/shared/src/file-types/`, and that repo deploys on its own. Pushing a
# registry change without carrying it over means the API starts validating
# uploads against types the live picker does not offer — or worse, offers types
# it will reject.
#
# A REMINDER, not a failure: backend-then-frontend is the normal order, so the
# copy being uncommitted there is expected — the mistake is stopping there.
if [ -d ../app/.git ]; then
  # Two distinct states, and the old hook only saw the second one: the sync was
  # never RUN (frontend still holds the previous registry, working tree clean),
  # or it ran and was never COMMITTED.
  if ! bun run --filter '@fretik/shared' file-types:sync --check >/dev/null 2>&1; then
    echo ""
    echo "⚠️  The file-type registry changed and ../app has not been re-synced."
    echo "   Run: bun run --filter '@fretik/shared' file-types:sync"
    echo ""
  elif [ -n "$(git -C ../app status --porcelain -- generated/file-types)" ]; then
    echo ""
    echo "⚠️  The file-type registry copy in ../app is not committed there yet."
    echo "   Until fretik-app is pushed, its uploads use the old registry."
    echo ""
  fi
fi
