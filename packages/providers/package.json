{
  "name": "@fretik/providers",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "smoke": "bun src/index.ts",
    "gen:sdk": "bun run scripts/generate-sdk.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./outlook": "./src/outlook/index.ts",
    "./imap-smtp": "./src/imap-smtp/index.ts",
    "./exchange": "./src/exchange/index.ts",
    "./front": "./src/front/index.ts",
    "./shiptify": "./src/shiptify/index.ts",
    "./teams": "./src/teams/index.ts"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ewsjs/xhr": "^3.1.3",
    "@fretik/shared": "workspace:*",
    "ews-javascript-api": "^0.15.3",
    "imapflow": "^1.4.1",
    "mailparser": "^3.9.10",
    "nodemailer": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@typescript/native-preview": "^7.0.0-dev.20260618.1",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "prettier": "^3.8.4",
    "prettier-plugin-organize-imports": "^4.3.0"
  }
}
