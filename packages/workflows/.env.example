# Trigger.dev — DEV secret key from the dashboard (Project → API Keys).
# Needed to trigger tasks from backend code; the `trigger dev` server itself
# only needs the CLI login (`npx trigger.dev@latest login`).
TRIGGER_SECRET_KEY=

# Self-hosted instance URL. Required whenever TRIGGER_SECRET_KEY is set —
# without it the SDK falls back to cloud (api.trigger.dev) and rejects a
# self-hosted key. Set this in every service that calls the SDK (ai, api,
# jobs, workflows), not just here.
TRIGGER_API_URL=https://triggerdev.fretik.com
