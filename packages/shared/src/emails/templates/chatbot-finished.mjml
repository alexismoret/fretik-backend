<mj-column width="100%">
  <mj-text>{{ greeting }}</mj-text>

  <mj-text padding-top="12px">{{ intro }}</mj-text>

  <mj-button
    href="{{conversationUrl}}"
    padding-top="24px"
    padding-bottom="28px"
  >
    {{ cta }}
  </mj-button>

  <mj-text padding="0">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e4e4e7;
        border-radius: 2px;
      "
    >
      <tr>
        <td
          style="
            padding: 10px 16px;
            background-color: #fafafa;
            border-bottom: 1px solid #e4e4e7;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 12px;
            font-weight: 600;
            line-height: 16px;
            color: #52525b;
          "
        >
          <span
            style="
              display: inline-block;
              width: 7px;
              height: 7px;
              margin-right: 8px;
              background-color: #14b8a6;
              vertical-align: 1px;
            "
          ></span
          >{{ replyHeader }}
        </td>
      </tr>
      <tr>
        <td style="padding: 16px 20px 4px 20px">{{{ assistantHtml }}}</td>
      </tr>
    </table>
  </mj-text>

  {{#if oversizedAttachmentsNotice}}
  <mj-text
    padding-top="16px"
    font-size="13px"
    line-height="20px"
    color="#71717a"
  >
    {{ oversizedAttachmentsNotice }}
  </mj-text>
  {{/if}}
</mj-column>
