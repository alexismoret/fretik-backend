<mj-column width="100%">
  <mj-text>{{ greeting }}</mj-text>

  <mj-text padding-top="12px">{{ intro }}</mj-text>

  <mj-button href="{{runUrl}}" padding-top="24px" padding-bottom="28px">
    {{ cta }}
  </mj-button>

  {{#if operations}}
  <mj-text padding="0 0 16px 0">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e4e4e7;
        border-radius: 2px;
      "
    >
      <tr>
        <td
          style="
            padding: 10px 16px;
            background-color: #fafafa;
            border-bottom: 1px solid #e4e4e7;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 12px;
            font-weight: 600;
            line-height: 16px;
            color: #52525b;
          "
        >
          <span
            style="
              display: inline-block;
              width: 7px;
              height: 7px;
              margin-right: 8px;
              background-color: #14b8a6;
              vertical-align: 1px;
            "
          ></span
          >{{ planHeader }}
        </td>
      </tr>
      <tr>
        <td
          style="
            padding: 16px 20px;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 14px;
            line-height: 22px;
            color: #3f3f46;
          "
        >
          <ol style="margin: 0; padding-left: 20px">
            {{#each operations}}
            <li style="margin: 0 0 6px 0; color: #18181b">{{ title }}</li>
            {{/each}}
          </ol>
        </td>
      </tr>
    </table>
  </mj-text>
  {{/if}}

  {{#if questions}}
  <mj-text padding="0">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e4e4e7;
        border-radius: 2px;
      "
    >
      <tr>
        <td
          style="
            padding: 10px 16px;
            background-color: #fafafa;
            border-bottom: 1px solid #e4e4e7;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 12px;
            font-weight: 600;
            line-height: 16px;
            color: #52525b;
          "
        >
          <span
            style="
              display: inline-block;
              width: 7px;
              height: 7px;
              margin-right: 8px;
              background-color: #14b8a6;
              vertical-align: 1px;
            "
          ></span
          >{{ questionsHeader }}
        </td>
      </tr>
      <tr>
        <td style="padding: 16px 20px 2px 20px">
          {{#each questions}}
          <div style="margin-bottom: 16px">
            <div
              style="
                font-family:
                  &quot;Public Sans&quot;,
                  -apple-system,
                  BlinkMacSystemFont,
                  &quot;Segoe UI&quot;,
                  Helvetica,
                  Arial,
                  sans-serif;
                font-size: 14px;
                font-weight: 600;
                line-height: 21px;
                color: #18181b;
                margin-bottom: 2px;
              "
            >
              {{ question }}
            </div>
            {{#if multiSelect}}
            <div
              style="
                font-family:
                  &quot;Public Sans&quot;,
                  -apple-system,
                  BlinkMacSystemFont,
                  &quot;Segoe UI&quot;,
                  Helvetica,
                  Arial,
                  sans-serif;
                font-size: 12px;
                line-height: 18px;
                color: #71717a;
                margin-bottom: 6px;
              "
            >
              {{../multiSelectHint}}
            </div>
            {{/if}}
            <ul
              style="
                margin: 6px 0 0 0;
                padding-left: 20px;
                font-family:
                  &quot;Public Sans&quot;,
                  -apple-system,
                  BlinkMacSystemFont,
                  &quot;Segoe UI&quot;,
                  Helvetica,
                  Arial,
                  sans-serif;
                font-size: 14px;
                line-height: 22px;
                color: #3f3f46;
              "
            >
              {{#each options}}
              <li style="margin-bottom: 4px">
                <strong style="font-weight: 600; color: #18181b">{{
                  label
                }}</strong
                >{{#if description}}: {{ description }}{{/if}}
              </li>
              {{/each}}
            </ul>
          </div>
          {{/each}}
        </td>
      </tr>
    </table>
  </mj-text>
  {{/if}}

  {{#if genericDetail}}
  <mj-text
    padding-top="16px"
    font-size="13px"
    line-height="20px"
    color="#71717a"
  >
    {{ genericDetail }}
  </mj-text>
  {{/if}}
</mj-column>
