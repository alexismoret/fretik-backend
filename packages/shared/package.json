{
  "name": "@fretik/shared",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests/unit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "e2b:build": "bun run src/services/e2b/template/build.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./services/*": "./src/services/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./emails/*": "./src/emails/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@better-auth/drizzle-adapter": "^1.5.4",
    "@better-auth/redis-storage": "^1.5.4",
    "@e2b/code-interpreter": "^2.4.2",
    "@hono/zod-openapi": "^1.2.3",
    "@mistralai/mistralai": "^2.2.1",
    "ai": "^6.0.176",
    "better-auth": "^1.5.6",
    "chromiumly": "^5.2.1",
    "drizzle-orm": "^1.0.0-beta.16-ea816b6",
    "e2b": "^2.19.5",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.1",
    "handlebars": "^4.7.9",
    "hono": "^4.12.18",
    "i18next": "^26.0.10",
    "ioredis": "^5.10.1",
    "marked": "^18.0.3",
    "mjml": "^5.2.0",
    "node-poppler": "^9.1.2",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mjml": "^5.0.0",
    "@types/pg": "^8.20.0",
    "@types/sharp": "^0.32.0",
    "@typescript/native-preview": "^7.0.0-dev.20260508.1",
    "drizzle-kit": "^1.0.0-beta.16-ea816b6",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0"
  }
}
