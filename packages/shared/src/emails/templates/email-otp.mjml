<mj-column width="100%">
  <mj-text>{{ greeting }}</mj-text>

  <mj-text padding-top="12px">{{ intro }}</mj-text>

  <mj-text
    padding-top="28px"
    font-size="12px"
    font-weight="600"
    line-height="16px"
    color="#52525b"
  >
    {{ codeLabel }}
  </mj-text>
  <!-- The one centred thing in the mails: the code is what the reader
       came for, and a full-width box keeps it from floating in the corner.
       The extra 8px of left padding balances the letter-spacing trailing
       the last digit. -->
  <mj-text padding-top="8px">
    <table
      role="presentation"
      cellpadding="0"
      cellspacing="0"
      border="0"
      width="100%"
      style="
        border-collapse: separate;
        border-spacing: 0;
        border: 1px solid #e4e4e7;
        border-radius: 2px;
      "
    >
      <tr>
        <td
          style="
            padding: 18px 22px 18px 30px;
            background-color: #fafafa;
            text-align: center;
            font-family:
              &quot;Public Sans&quot;,
              -apple-system,
              BlinkMacSystemFont,
              &quot;Segoe UI&quot;,
              Helvetica,
              Arial,
              sans-serif;
            font-size: 30px;
            font-weight: 600;
            line-height: 36px;
            letter-spacing: 8px;
            color: #09090b;
          "
        >
          {{ code }}
        </td>
      </tr>
    </table>
  </mj-text>

  <mj-text
    padding-top="28px"
    font-size="13px"
    line-height="20px"
    color="#71717a"
  >
    {{ expiration }}
  </mj-text>

  <mj-text
    padding-top="4px"
    font-size="13px"
    line-height="20px"
    color="#a1a1aa"
  >
    {{ ignore }}
  </mj-text>
</mj-column>
