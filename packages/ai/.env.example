# ==================== #
# Service               #
# ==================== #
PORT=8083

# ==================== #
# Shared infra (same values as packages/shared/.env) #
# ==================== #
DATABASE_URL=
REDIS_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
APP_URL=

# ==================== #
# Page rendering (managePage review — headless browser)
# ==================== #
# Leave everything blank on macOS: an installed Chrome is auto-detected, and a
# machine with none degrades to a review without screenshots rather than failing.
#
# Two production shapes, pick ONE:
#  a) Chrome inside this image  → PAGE_RENDER_CHROMIUM_PATH=/usr/bin/chromium
#  b) a browser in its own container (browserless) → BOTH of the next two.
#     PAGE_RENDER_SELF_HOST is the name that container reaches THIS service by;
#     without it the browser looks for the harness on its own loopback and every
#     render comes back blank.
PAGE_RENDER_BROWSER_WS=
PAGE_RENDER_SELF_HOST=
PAGE_RENDER_CHROMIUM_PATH=
# Where the page-runtime bundle comes from. Unset, it is fetched over APP_URL —
# which is the production path, since only the frontend deploy carries it.
PAGE_RUNTIME_DIR=

# ==================== #
# Scaleway — Object Storage (persisted outputs) + email
# ==================== #
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_EMAIL_REGION=fr-par
S3_BUCKET=
S3_URL=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
EMAIL_FROM_NAME=Fretik
EMAIL_FROM_ADDRESS=no-reply@fretik.com

# ==================== #
# AI providers — OpenRouter
# ==================== #
OPENROUTER_API_KEY=

# Upper bound (clamped [2000, 32000]) on the tokens the summariser is
# allowed to emit. Aligned with Claude Code's MAX_OUTPUT_TOKENS_FOR_SUMMARY
# (20K, p99.99 observed = 17.4K). Bumped from the previous 8K because the
# 9-section CC-aligned prompt produces longer summaries than the old
# 5-section one did.
COMPACTION_SUMMARIZER_MAX_TOKENS=20000

# Wall-clock timeout (ms) for the summariser call (clamped [10000, 300000]).
# 90s comfortably covers worst-case TTFT + 20K-token output even on cold
# OpenRouter routes. Bumped from 20s after observing false aborts on
# 100K+ token inputs where the model finished but the client-side abort
# fired during the final HTTP read.
COMPACTION_SUMMARIZER_TIMEOUT_MS=90000

# Number of most-recent compactable tool-results microcompact keeps
# verbatim before replacing older ones with a marker. Clamped [1, 30].
# Mirrors Claude Code's keepRecent default of 5.
COMPACTION_MICROCOMPACT_KEEP_RECENT=5

# Hard cap on LLM steps per chatbot turn. Mirrors Claude Code's
# `MAX_TURNS = 30` as the baseline. Slight bumps (e.g. 35) accommodate
# heavy multi-doc extraction without diverging much from the published
# pattern. Clamped [1, 200]; service refuses to boot if outside that
# range.
CHATBOT_MAX_STEPS=35

# Step budget for `dispatchAgent` sub-agents (read, searchKnowledge,
# querySql, python, bash, …). Smaller than the main agent's budget
# because each sub-task is meant to be well-scoped; runaway sub-agents
# stop and escalate to the parent via the `[incomplete]` marker. Range
# [1, 100]. Default 25. See src/agents/chatbot/index.ts:268.
CHATBOT_SUB_AGENT_MAX_STEPS=25

# Embedding model — halfvec(2560), Matryoshka truncation via
# `dimensions: 2560` OpenRouter param.
OPENROUTER_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

# Rerank model — Phase 7c RAG final stage. Top-50 hybrid
# candidates → top-20 via OpenRouter /rerank endpoint.
OPENROUTER_RERANK_MODEL=cohere/rerank-4-fast

# Manual prompt-cache breakpoint middleware — src/lib/openrouter-cache.ts
# Default true. Inserts `cache_control: { type: "ephemeral" }` blocks for
# explicit-caching upstreams (Anthropic, Qwen, deepseek-v3.2). Set to
# "false" when OPENROUTER_CHAT_MODEL caches automatically (Deepseek V4
# Pro, OpenAI, Gemini 2.5, Grok) to skip the middleware entirely.
MANUAL_PROMPT_CACHE=true
# Optional. Logs breakpoint placement decisions on every call.
AI_CACHE_DEBUG=false

# ==================== #
# Gotenberg — PDF conversion reached transitively by the chat-file
# Drive-upload path (services/chat-files/upload.ts → shared
# uploadDocument → shared services/documents/convert.ts, which
# instantiates its gotenberg client at module load). Non-PDF
# attachments uploaded with the Save-to-Drive toggle are converted
# to PDF here before the Drive pipeline runs OCR.
# ==================== #
GOTENBERG_ENDPOINT=
GOTENBERG_API_BASIC_AUTH_USERNAME=
GOTENBERG_API_BASIC_AUTH_PASSWORD=

# ==================== #
# Mistral — OCR (mistral-ocr-latest)
# Used by /internal/pre-extract for documents and by the Phase 11
# chat-file preprocessor (services/chat-files/preprocess.ts) to
# produce {basename}.md sidecars for PDFs / Office docs / images.
# ==================== #
MISTRAL_API_KEY=

# ==================== #
# Chat-files orphan reaper (Phase 11) — BullMQ repeatable cron.
# Runs inside @fretik/ai; idempotent across replicas.
# ==================== #
CHAT_FILES_ORPHAN_CRON=0 3 * * *

# ==================== #
# Tools — Tavily (web search + /extract + /map)
# ==================== #
# Unset = the web tools are pruned from every agent registry (the service
# still boots; searchWeb/webFetch/webMap simply do not exist).
TAVILY_API_KEY=
# Per-call wall-clock timeouts for Tavily calls (ms). See src/lib/tavily.ts.
AI_TAVILY_SEARCH_TIMEOUT_MS=10000
# A search with images captions them server-side — measured 3× slower.
AI_TAVILY_SEARCH_IMAGES_TIMEOUT_MS=25000
AI_TAVILY_EXTRACT_TIMEOUT_MS=15000
AI_TAVILY_MAP_TIMEOUT_MS=15000
# USD per Tavily credit, for the cost traced to Langfuse. Only a fallback:
# calls request the actual billed credits. Default 0.008 (pay-as-you-go).
TAVILY_PRICE_PER_CREDIT=
# Egress hardening for the web tools — see src/lib/web-egress.ts. The web
# is OPEN by default; these are opt-in operator levers (all empty/unset = open).
# Internal/private/loopback/metadata targets and non-http(s) schemes are ALWAYS
# blocked regardless of these. Comma-separated; "*.example.com" matches subdomains.
# Never-fetchable domains (also dropped from searchWeb/webMap results):
AI_WEB_BLOCKED_DOMAINS=
# When non-empty, flips to deny-by-default: only these are fetchable, and
# searchWeb/webMap stop surfacing anything outside the list.
AI_WEB_ALLOWED_DOMAINS=
# Max fetch-URL length (chars), default 2048:
AI_WEB_FETCH_MAX_URL_LEN=
# Set to "false" to fully disable searchWeb + webFetch + webMap for this
# deployment (chat, workflow runs, and sub-agents alike):
AI_WEB_TOOLS_ENABLED=

# ==================== #
# SQL tool dedicated role — see src/lib/db-readonly.ts
# ==================== #
# Connection string for the least-privilege `fretik_sql_tool` role (created by
# the shared `harden_sql_tool` migration). REQUIRED — the SQL tool refuses to
# boot without it, and must NOT point at the owner DATABASE_URL (the owner
# bypasses row-level security). Operator step: set the role's password once —
#   ALTER ROLE fretik_sql_tool LOGIN PASSWORD '<pw>';
# then point this at it, e.g. postgres://fretik_sql_tool:<pw>@host:5432/<db>
AI_DB_READONLY_URL=
# Max concurrent read-only connections per pod.
AI_DB_READONLY_POOL_MAX=10

# ==================== #
# Internal auth        #
# Generate with: openssl rand -hex 32
# ==================== #
INTERNAL_KEY=

# ==================== #
# Vectorisation rate limits — global caps across all @fretik/ai
# replicas, enforced via the Redis distributed semaphore.
# ==================== #
AI_CHEAP_MODEL_MAX_CONCURRENT=20
AI_EMBEDDING_MAX_CONCURRENT=10

# ==================== #
# E2B sandbox — backend/packages/shared/src/services/e2b/*
# API key for https://e2b.dev. E2B replaces the previous self-hosted
# orchestrator: the chatbot's `python` and `bash` tools spin up an E2B
# sandbox per conversation (paused between turns at $0 cost).
# Get the key from https://e2b.dev/dashboard.
# `E2B_TEMPLATE` is the registered template name built via
# `bun run e2b:build` from @fretik/shared (default: fretik-sandbox).
# `E2B_PRICE_PER_SECOND` is the estimated sandbox rate used to cost the
# `e2b-bash` / `e2b-python` Langfuse observations (default 0.0001 = $0.36/h).
# `FRETIK_ENV` names this deployment; it is stamped into sandbox metadata and
# the orphan sweep only kills sandboxes carrying ITS OWN tag. Set it on every
# deployment that shares an `E2B_API_KEY` with another one, or a restart of one
# will reclaim the other's live sandboxes. Falls back to
# LANGFUSE_TRACING_ENVIRONMENT, then "unknown".
# ==================== #
E2B_API_KEY=
E2B_TEMPLATE=fretik-sandbox
E2B_PRICE_PER_SECOND=
FRETIK_ENV=

# ==================== #
# Sandbox JWT — HS256 secret signed by @fretik/ai per-turn and
# verified by @fretik/api on every `POST /sandbox/exec`. Must match
# the same env var in @fretik/api/.env. Generate with:
# `openssl rand -hex 32`.
# ==================== #
SANDBOX_JWT_SECRET=

# ==================== #
# Public URL of @fretik/api as seen FROM INSIDE the E2B sandbox. The
# Python SDK reads it from /workspace/.fretik/auth.json and POSTs to
# `${url}/sandbox/exec`. In local dev, `dev.sh` provisions a tunnl.gg
# forwarding and injects the resulting URL at launch time, so this
# field can stay empty. In prod, set it to the public API hostname.
# ==================== #
FRETIK_BACKEND_INTERNAL_URL=

# ==================== #
# Chatbot rate limiter — src/middlewares/chatbot-rate-limit.ts
# Per-team sliding-log limit on POST /chatbot/stream. Default 20
# requests per minute. The /internal/invoke route is NOT limited.
# ==================== #
AI_CHATBOT_RATE_LIMIT_PER_MIN=20

# ==================== #
# RAG debug channel (Phase 9) — when true, rag-search forwards its
# internal scoring trace (semanticRank / bm25Rank / rrfScore /
# rerankScore / variants) on the tool output so the frontend can
# render the RetrievalDebugPanel. Must be paired with
# NUXT_PUBLIC_RAG_DEBUG=true on the Nuxt app for the UI to render.
# Off in production — zero extra payload, zero model-context cost.
# ==================== #
AI_RAG_DEBUG=false

# ==================== #
# Eval harness — evals/ (Phase 10)
# Consumed ONLY by `bun run evals`, never by the production service.
# See backend/packages/ai/evals/run.ts for the full env contract.
# ==================== #
# URL of a running @fretik/ai the evals will POST against.
AI_SERVICE_URL=http://localhost:8083
# UUID of the team whose data the evals query (must exist in the DB).
EVAL_TEAM_ID=
# Parent organization UUID of EVAL_TEAM_ID.
EVAL_ORGANIZATION_ID=
# Optional context forwarded as X-Context-* headers on /internal/invoke.
EVAL_USER_ID=
EVAL_USER_NAME=
EVAL_TIMEZONE=Europe/Paris
# LLM-as-judge model. Different family than the production chatbot
# (MiniMax M2.7) to avoid self-evaluation bias. Default
# deepseek/deepseek-v3.2. Override with claude-sonnet / gpt-4o if
# DeepSeek becomes a bottleneck.
OPENROUTER_EVAL_JUDGE_MODEL=deepseek/deepseek-v3.2
