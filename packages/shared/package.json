{
  "name": "@fretik/shared",
  "version": "0.7.8",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests/unit",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "db:generate": "bun --env-file=../../.env drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env drizzle-kit migrate",
    "db:push": "bun --env-file=../../.env drizzle-kit push",
    "db:studio": "bun --env-file=../../.env drizzle-kit studio",
    "e2b:build": "bun run src/services/e2b/template/build.ts",
    "file-types:sync": "bun run src/scripts/sync-file-types-to-frontend.ts",
    "grant:super-admin": "bun --env-file=.env run src/scripts/grant-super-admin.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./db/schema": "./src/db/schema/index.ts",
    "./file-types": "./src/file-types/index.ts",
    "./file-types/*": "./src/file-types/*.ts",
    "./model-registry/*": "./src/model-registry/*.ts",
    "./services/*": "./src/services/*.ts",
    "./lib/*": "./src/lib/*.ts",
    "./schemas": "./src/schemas/index.ts",
    "./schemas/*": "./src/schemas/*.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts",
    "./emails/*": "./src/emails/*.ts",
    "./templates/*": "./src/templates/*.ts",
    "./templates/document-fields": "./src/templates/document-fields/index.ts",
    "./external-apps/*": "./src/external-apps/*.ts"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.41",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/electron": "^1.7.2",
    "@better-auth/redis-storage": "^1.7.2",
    "@e2b/code-interpreter": "^2.7.2",
    "@hono/zod-openapi": "^1.6.1",
    "@kenjiuno/msgreader": "^1.28.0",
    "@mistralai/mistralai": "^2.6.4",
    "@nangohq/node": "^0.71.5",
    "@tailwindcss/cli": "^4.3.3",
    "@trigger.dev/sdk": "4.5.14",
    "ai": "^7.0.85",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.2",
    "bullmq": "^6.3.2",
    "chromiumly": "^6.0.0",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "e2b": "^2.46.1",
    "exceljs": "^4.4.0",
    "file-type": "^22.0.2",
    "handlebars": "^4.7.9",
    "hono": "^4.13.5",
    "hono-rate-limiter": "^0.5.3",
    "i18next": "^26.4.0",
    "ioredis": "5.11.1",
    "jose": "^6.2.10",
    "marked": "^18.0.11",
    "mdream": "^1.7.0",
    "mjml": "^5.4.0",
    "node-poppler": "^10.0.1",
    "pg": "^8.23.0",
    "postal-mime": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/mjml": "^5.0.0",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^1.0.0-rc.4-5d5b77c",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
