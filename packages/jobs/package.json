{
  "name": "@fretik/jobs",
  "version": "0.7.10",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "backfill:episodes": "bun run src/scripts/backfill-episodes.ts",
    "backfill:record-cards": "bun run src/scripts/backfill-record-cards.ts",
    "dreaming:run": "bun run src/scripts/run-dreaming.ts",
    "memory:audit": "bun run src/scripts/memory-audit.ts",
    "gc:run": "bun run src/scripts/run-gc.ts",
    "models:sync": "bun run src/scripts/run-model-sync.ts",
    "test": "NODE_ENV=test bun test tests/unit",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run typecheck && bun run lint && bun run format:check"
  },
  "dependencies": {
    "@fretik/providers": "workspace:*",
    "@fretik/shared": "workspace:*",
    "bullmq": "^6.3.2",
    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
