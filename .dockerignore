# Dependencies (re-installed in the install stage)
node_modules
**/node_modules

# Git + VCS noise
.git
.gitignore
.gitattributes

# Husky is copied into the install stage so the root `prepare` script
# can resolve .husky/install.mjs — the script then self-exits on
# CI=true. The release stage doesn't COPY .husky, so it never reaches
# the final image. Do NOT add .husky here.

# Tooling local state
.claude
.claude-flow
.idea
.vscode
.DS_Store
**/.DS_Store

# Tests + evals never ship in production images
**/tests
**/evals
**/*.test.ts
.eval-runs
**/.eval-runs

# Env files (Dokploy injects them at runtime)
.env
.env.*
!**/.env.example

# Docs not needed at runtime
README.md
**/CLAUDE.md
docs

# Build artefacts / caches
**/dist
**/coverage
*.tsbuildinfo
**/*.tsbuildinfo
**/.cache
*.log
logs

# Lint/format configs not needed at runtime
.oxlintrc.json
prettier.config.js
.prettierignore
.prettierrc*

# CI configs not needed at runtime
.github
