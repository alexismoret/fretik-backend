{
  "name": "@fretik/ai",
  "version": "0.7.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "NODE_ENV=test bun test tests/unit",
    "test:integration": "NODE_ENV=test bun test tests/integration",
    "nuxt-ui:sync-docs": "bun scripts/sync-nuxt-ui-docs.ts",
    "evals:langfuse": "bun run evals/run.ts",
    "evals:recall": "bun run evals/recall/run.ts",
    "evals:memory": "bun run evals/memory/run.ts",
    "evals:chain": "bun run evals/chain/run.ts",
    "evals:gate": "bun run evals/langfuse/gate.ts",
    "evals:pages-compare": "bun run evals/page-compare.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "langfuse:seed-prompts": "bun run scripts/seed-langfuse-prompts.ts",
    "langfuse:triage-cases": "bun run scripts/triage-eval-cases.ts",
    "langfuse:sync-datasets": "bun run evals/langfuse/dataset-sync.ts",
    "langfuse:seed-eval-config": "bun run scripts/seed-langfuse-eval-config.ts",
    "measure:tokens": "bun run scripts/measure-system-prompt-tokens.ts",
    "models:check": "bun run scripts/check-model-catalog.ts",
    "models:bench": "bun run scripts/measure-upstreams.ts",
    "backfill:orphan-think": "bun run scripts/backfill-orphan-think-tags.ts"
  },
  "dependencies": {
    "@ai-sdk/provider": "^4.0.3",
    "@fretik/providers": "workspace:*",
    "@fretik/shared": "workspace:*",
    "@hono/zod-openapi": "^1.4.0",
    "@langfuse/client": "^5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@langfuse/vercel-ai-sdk": "^5.9.1",
    "@mistralai/mistralai": "^2.2.6",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@tavily/core": "^0.7.7",
    "ai": "^7.0.19",
    "ajv": "^8.17.1",
    "bullmq": "^5.79.0",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "e2b": "^2.46.0",
    "figlet": "^1.11.0",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.12.26",
    "ioredis": "5.10.1",
    "node-sql-parser": "^5.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/figlet": "^1.7.0",
    "@types/json-schema": "^7.0.15",
    "@types/pg": "^8.20.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.74.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.9.5",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
