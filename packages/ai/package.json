{
  "name": "@fretik/ai",
  "version": "0.7.15",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test --isolate --timeout=10000 tests/unit",
    "test:integration": "INTEGRATION_DB=1 bun test --isolate --timeout=30000 tests/integration",
    "nuxt-ui:sync-docs": "bun scripts/sync-nuxt-ui-docs.ts",
    "evals:langfuse": "bun run evals/run.ts",
    "evals:recall": "bun run evals/recall/run.ts",
    "evals:memory": "bun run evals/memory/run.ts",
    "evals:chain": "bun run evals/chain/run.ts",
    "evals:gate": "bun run evals/langfuse/gate.ts",
    "evals:pages-compare": "bun run evals/page-compare.ts",
    "evals:transport-smoke": "bun run evals/transport-smoke.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check",
    "langfuse:seed-prompts": "bun run scripts/seed-langfuse-prompts.ts",
    "langfuse:triage-cases": "bun run scripts/triage-eval-cases.ts",
    "langfuse:sync-datasets": "bun run evals/langfuse/dataset-sync.ts",
    "langfuse:seed-eval-config": "bun run scripts/seed-langfuse-eval-config.ts",
    "measure:tokens": "bun run scripts/measure-system-prompt-tokens.ts",
    "models:check": "bun run scripts/check-model-catalog.ts",
    "models:bench": "bun run scripts/measure-upstreams.ts",
    "models:admin": "bun run scripts/model-admin.ts",
    "backfill:orphan-think": "bun run scripts/backfill-orphan-think-tags.ts",
    "backfill:discovery-vectors": "bun run scripts/backfill-discovery-vectors.ts",
    "models:export": "bun run scripts/export-fleet.ts",
    "models:apply": "bun run scripts/apply-fleet-manifest.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.69",
    "@ai-sdk/openai-compatible": "^3.0.41",
    "@ai-sdk/provider": "^4.0.9",
    "@fretik/providers": "workspace:*",
    "@fretik/shared": "workspace:*",
    "@hono/zod-openapi": "^1.6.1",
    "@langfuse/client": "^5.11.0",
    "@langfuse/otel": "^5.11.0",
    "@langfuse/tracing": "^5.11.0",
    "@langfuse/vercel-ai-sdk": "^5.11.0",
    "@mistralai/mistralai": "^2.6.4",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@tavily/core": "^0.7.8",
    "ai": "^7.0.85",
    "ajv": "^8.20.0",
    "bullmq": "^6.3.2",
    "drizzle-orm": "^1.0.0-rc.4-5d5b77c",
    "e2b": "^2.46.1",
    "figlet": "^1.11.4",
    "gpt-tokenizer": "^3.4.0",
    "hono": "^4.13.5",
    "ioredis": "5.11.1",
    "node-sql-parser": "^5.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/figlet": "^1.7.0",
    "@types/json-schema": "^7.0.15",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^0.24.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
